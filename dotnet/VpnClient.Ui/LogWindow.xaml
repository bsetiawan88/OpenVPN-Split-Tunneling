<ui:FluentWindow x:Class="VpnClient.Ui.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OpenVPN Log"
        Height="560" Width="860"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenVPN Log" />

        <Border Grid.Row="1" Margin="24,12,24,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="12">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <ui:TextBlock x:Name="LogText"
                              FontFamily="Consolas"
                              FontTypography="Caption"
                              TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          x:Name="AutoScrollCheck"
                          Content="Auto-scroll"
                          IsChecked="True"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Refresh" Click="RefreshBtn_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Close" Click="CloseBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
