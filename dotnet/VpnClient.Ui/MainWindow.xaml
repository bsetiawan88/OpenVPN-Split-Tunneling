<ui:FluentWindow x:Class="VpnClient.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:VpnClient.Ui"
        mc:Ignorable="d"
        Title="OpenVPN Split Tunneling Client"
        Height="800" Width="900"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenVPN Split Tunneling Client" />

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: VPN state + Connect -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="Gray" Margin="0,0,12,0" />
                            <ui:ProgressRing x:Name="StateSpinner"
                                             IsIndeterminate="True"
                                             Width="16" Height="16"
                                             Margin="0,0,12,0"
                                             Visibility="Collapsed" />
                            <ui:TextBlock x:Name="StateText"
                                          Text="Connecting to redirector…"
                                          FontTypography="Subtitle" />
                        </StackPanel>
                        <ui:TextBlock x:Name="AdapterText"
                                      Text=""
                                      FontTypography="Body"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="24,4,0,0" />
                        <ui:TextBlock x:Name="ProfileText"
                                      Text=""
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Margin="24,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="RotateNowBtn"
                                   Content="Rotate"
                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                   Appearance="Secondary"
                                   IsEnabled="False"
                                   ToolTip="Connect first, then rotate"
                                   Click="RotateNowBtn_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="VpnSettingsBtn"
                                   Icon="{ui:SymbolIcon Settings20}"
                                   Appearance="Secondary"
                                   ToolTip="VPN profiles &amp; credentials (reads C:\Program Files\OpenVPN\config)"
                                   Click="VpnSettingsBtn_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="ConnectBtn"
                                   Content="Connect"
                                   Icon="{ui:SymbolIcon Play20}"
                                   Appearance="Primary"
                                   IsEnabled="False"
                                   Click="ConnectBtn_Click"
                                   ToolTip="Connect using a random profile" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats row -->
            <Border Grid.Row="1" Margin="0,16,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              x:Name="RotateCheck"
                              Content="Rotate every"
                              Checked="RotateCheck_Changed"
                              Unchecked="RotateCheck_Changed"
                              VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2"
                              x:Name="RotateIntervalBox"
                              Width="110"
                              VerticalAlignment="Center"
                              SelectionChanged="RotateIntervalBox_SelectionChanged" />
                    <ui:TextBlock Grid.Column="4"
                                  x:Name="RotateHintText"
                                  Text="Rotate off"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <ui:TextBlock Text="Total Out" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock x:Name="BytesOutText" Text="0 B" FontTypography="Subtitle" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <ui:TextBlock Text="Total In" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock x:Name="BytesInText" Text="0 B" FontTypography="Subtitle" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <ui:TextBlock Text="Uptime" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock x:Name="UptimeText" Text="—" FontTypography="Subtitle" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Apps section -->
            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="Tunneled Apps" FontTypography="Subtitle" />
                        <CheckBox Grid.Column="1"
                                  x:Name="LogCheck"
                                  Content="Enable logging"
                                  Checked="LogCheck_Changed"
                                  Unchecked="LogCheck_Changed"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <CheckBox Grid.Column="2"
                                  x:Name="FullTunnelCheck"
                                  Content="Full tunnel"
                                   ToolTip="ON: all traffic via VPN (recommended, works everywhere). OFF: split-tunnel — only listed apps' traffic via VPN. Plain DNS for ALL apps uses your local network (fast, correct region), so site names of listed apps are visible locally; their traffic stays in the VPN."
                                  Checked="FullTunnelCheck_Changed"
                                  Unchecked="FullTunnelCheck_Changed"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <ui:Button Grid.Column="3"
                                   x:Name="ManageAppsBtn"
                                   Content="Manage"
                                   Icon="{ui:SymbolIcon Settings20}"
                                   Click="SettingsBtn_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                                        <ui:CardExpander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding DisplayName}" FontTypography="BodyStrong" />
                                                    <ui:TextBlock Text="{Binding ProcessCountText}"
                                                                  FontTypography="Caption"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                  Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right">
                                                        <ui:TextBlock Text="{Binding RateOutText}"
                                                                      FontTypography="Caption"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <ui:TextBlock Text="{Binding TotalOutText}" FontTypography="Body" />
                                                    </StackPanel>
                                                    <StackPanel HorizontalAlignment="Right">
                                                        <ui:TextBlock Text="{Binding RateInText}"
                                                                      FontTypography="Caption"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <ui:TextBlock Text="{Binding TotalInText}" FontTypography="Body" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </ui:CardExpander.Header>

                                        <ItemsControl ItemsSource="{Binding Pids}" Margin="0,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBlock Grid.Column="0"
                                                                      Text="{Binding PidText}"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                      VerticalAlignment="Center"
                                                                      FontTypography="Caption" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right">
                                                                <ui:TextBlock Text="{Binding RateOutText}"
                                                                              FontTypography="Caption"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <ui:TextBlock Text="{Binding TotalOutText}" FontTypography="Caption" />
                                                            </StackPanel>
                                                            <StackPanel HorizontalAlignment="Right">
                                                                <ui:TextBlock Text="{Binding RateInText}"
                                                                              FontTypography="Caption"
                                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                <ui:TextBlock Text="{Binding TotalInText}" FontTypography="Caption" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:CardExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ui:TextBlock x:Name="EmptyAppsText"
                                  Grid.Row="1"
                                  Margin="0,24,0,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="No tunneled apps yet — click Manage to add one"
                                  Visibility="Collapsed" />
                </Grid>
            </Border>
            </Grid>

            <!-- Log areas, side by side on the right (visible only when "Enable logging" is checked) -->
            <Border Grid.Column="2"
                    x:Name="LogPanel"
                    Width="500"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20,12"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top half: redirector activity -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="Activity"
                                          FontTypography="Subtitle"
                                          VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button x:Name="ClearLogBtn"
                                           Content="Clear"
                                           Click="ClearLogBtn_Click"
                                           Margin="0,0,8,0" />
                                <ui:Button x:Name="CopyActivityBtn"
                                           Content="Copy"
                                           Click="CopyActivityBtn_Click" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      x:Name="LogScroller">
                            <TextBox x:Name="LogText"
                                     Text=""
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Bottom half: openvpn.log -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="OpenVPN Log"
                                          FontTypography="Subtitle"
                                          VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button x:Name="RefreshOvpnLogBtn"
                                           Content="Refresh"
                                           Click="RefreshOvpnLogBtn_Click"
                                           Margin="0,0,8,0" />
                                <ui:Button x:Name="CopyOvpnLogBtn"
                                           Content="Copy"
                                           Click="CopyOvpnLogBtn_Click" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="OpenVpnLogText"
                                     Text=""
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="24,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ui:TextBlock x:Name="FooterText"
                          Text="OpenVPN Split Tunneling Client"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
