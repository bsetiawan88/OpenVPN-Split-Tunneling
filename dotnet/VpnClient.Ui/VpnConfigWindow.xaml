<ui:FluentWindow x:Class="VpnClient.Ui.VpnConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="VPN Configurations"
        Height="700" Width="900"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VPN Configurations" />

        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:Button Grid.Row="0"
                           x:Name="RefreshBtn"
                           Content="Refresh"
                           Icon="{ui:SymbolIcon ArrowClockwise20}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Click="RefreshBtn_Click"
                           Margin="0,0,0,8" />
                <ui:Button Grid.Row="1"
                           x:Name="OpenFolderBtn"
                           Content="Open config folder"
                           Icon="{ui:SymbolIcon FolderOpen20}"
                           Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           Click="OpenFolderBtn_Click"
                           Margin="0,0,0,12" />
                <Border Grid.Row="2"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="ProfileList"
                                  Grid.Row="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionChanged="ProfileList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,8">
                                        <ui:TextBlock Text="{Binding DisplayName}" FontTypography="BodyStrong" />
                                        <ui:TextBlock Text="{Binding ServerHostname}"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      FontTypography="Caption"
                                                      Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ui:TextBlock Grid.Row="1"
                                      x:Name="DirHintText"
                                      Text=""
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Margin="12,8"
                                      TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Detail editor -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="24">
              <Grid>
                <Grid x:Name="DetailGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Text="Profile"
                                      FontTypography="Subtitle"
                                      VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1"
                                   x:Name="ConnectProfileBtn"
                                   Content="Connect"
                                   Icon="{ui:SymbolIcon Play20}"
                                   Appearance="Primary"
                                   Click="ConnectProfileBtn_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <ui:TextBlock x:Name="FilePathText"
                                      Text=""
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock x:Name="NeedsAuthHint"
                                      Text="This profile requires username + password."
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      FontTypography="Caption"
                                      Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <ui:TextBlock Text="Display name"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,4" />
                        <ui:TextBox x:Name="DisplayNameBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <ui:TextBlock Text="Server (from .ovpn — read only)"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,4" />
                        <ui:TextBox x:Name="ServerHostnameBox" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,16">
                        <ui:TextBlock Text="Server override"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,4" />
                        <ui:TextBox x:Name="ServerOverrideBox"
                                    PlaceholderText="host or host:port — leave empty to use the .ovpn value" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,16">
                        <ui:TextBlock Text="Username"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,4" />
                        <ui:TextBox x:Name="UsernameBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,0,0,16">
                        <ui:TextBlock Text="Password"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,4" />
                        <ui:PasswordBox x:Name="PasswordBox" />
                        <ui:TextBlock Text="Stored encrypted via DPAPI (current user only)"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      FontTypography="Caption"
                                      Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button x:Name="ClearCredsBtn"
                                   Content="Clear credentials"
                                   Click="ClearCredsBtn_Click"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="SaveBtn"
                                   Content="Save"
                                   Icon="{ui:SymbolIcon Save20}"
                                   Appearance="Primary"
                                   Click="SaveBtn_Click" />
                    </StackPanel>
                </Grid>

                <ui:TextBlock x:Name="EmptyText"
                              Text="Pick a profile from the list to edit credentials."
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextWrapping="Wrap"
                              Visibility="Visible" />
              </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Close" Click="CloseBtn_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
